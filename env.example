# ---- বাধ্যতামূলক (Railway → Variables-এ বসান; এই ফাইল শুধু উদাহরণ, আসল মান কখনো গিটে নয়) ----
FIREBASE_SERVICE_ACCOUNT_B64=base64-of-service-account-json
FIREBASE_DATABASE_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com
ADMIN_EMAIL=omor.faruk.sojol.2@gmail.com
ALLOWED_ORIGINS=https://YOURNAME.github.io,https://yourdomain.com
CONFIG_ENC_KEY=base64-32-random-bytes        # node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OTP_HMAC_SECRET=long-random-string           # node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
NODE_ENV=production
# ---- ঐচ্ছিক ----
DAILY_SMS_CAP=300
APPCHECK_ENFORCE=false                       # App Check চালু করে সাইট পরীক্ষার পর true করুন
# PORT Railway নিজেই দেয়
