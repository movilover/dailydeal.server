# ---- বাধ্যতামূলক (Render → Environment-এ বসান; এই ফাইল শুধু উদাহরণ, আসল মান কখনো গিটে নয়) ----
# Railway-এর Variables থেকে হুবহু কপি করুন — বিশেষ করে CONFIG_ENC_KEY (বদলালে সংরক্ষিত OTP প্রোভাইডার কী আর পড়া যাবে না!)
FIREBASE_SERVICE_ACCOUNT_B64=base64-of-service-account-json
FIREBASE_DATABASE_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com
ADMIN_EMAIL=omor.faruk.sojol.2@gmail.com
ALLOWED_ORIGINS=https://YOURNAME.github.io,https://yourdomain.com
CONFIG_ENC_KEY=base64-32-random-bytes        # node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OTP_HMAC_SECRET=long-random-string           # node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
NODE_ENV=production
# ---- CJdropshipping (নতুন) ----
CJ_API_KEY=CJxxxx@api@xxxxxxxxxxxxxxxx       # CJ অ্যাকাউন্ট → Authorization → API key (শুধু এখানে, ব্রাউজারে নয়)
# ---- ঐচ্ছিক ----
DAILY_SMS_CAP=300
APPCHECK_ENFORCE=false                       # App Check চালু করে সাইট পরীক্ষার পর true করুন
KEEPALIVE_SELF=1                             # সার্ভার নিজেই প্রতি ১০ মিনিটে নিজের /ping কল করে (বন্ধ করতে 0)
# PORT Render নিজেই দেয় (সাধারণত 10000); RENDER_EXTERNAL_URL ও Render নিজেই দেয়
# Render-এ ইউজারের আসল IP ভুল এলে: TRUST_PROXY_HOPS=2
